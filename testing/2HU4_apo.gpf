npts 26 26 26                        # num.grid points in xyz
gridfld 2HU4_apo.maps.fld            # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C H HD N NA OA SA   # receptor atom types
ligand_types C OA HD N               # ligand atom types
receptor 2HU4_apo.pdbqt              # macromolecule
gridcenter -0.092 81.795 109.421     # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 2HU4_apo.C.map                   # atom-specific affinity map
map 2HU4_apo.OA.map                  # atom-specific affinity map
map 2HU4_apo.HD.map                  # atom-specific affinity map
map 2HU4_apo.N.map                   # atom-specific affinity map
elecmap 2HU4_apo.e.map               # electrostatic potential map
dsolvmap 2HU4_apo.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
