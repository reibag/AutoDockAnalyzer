# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by /usr/bin/autogrid4 4.2.7.x.2019-09-11.
#
#SPACING 0.375
#NELEMENTS 26 26 26
#CENTER -0.092 81.795 109.421
#MACROMOLECULE 2HU4_apo.pdbqt
#GRID_PARAMETER_FILE .\2HU4_apo.gpf
#
ndim=3			# number of dimensions in the field
dim1=27			# number of x-elements
dim2=27			# number of y-elements
dim3=27			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=6		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=2HU4_apo.maps.xyz filetype=ascii offset=0
coord 2 file=2HU4_apo.maps.xyz filetype=ascii offset=2
coord 3 file=2HU4_apo.maps.xyz filetype=ascii offset=4
label=C-affinity	# component label for variable 1
label=OA-affinity	# component label for variable 2
label=HD-affinity	# component label for variable 3
label=N-affinity	# component label for variable 4
label=Electrostatics	# component label for variable 5
label=Desolvation	# component label for variable 6
#
# location of affinity grid files and how to read them
#
variable 1 file=2HU4_apo.C.map filetype=ascii skip=6
variable 2 file=2HU4_apo.OA.map filetype=ascii skip=6
variable 3 file=2HU4_apo.HD.map filetype=ascii skip=6
variable 4 file=2HU4_apo.N.map filetype=ascii skip=6
variable 5 file=2HU4_apo.e.map filetype=ascii skip=6
variable 6 file=2HU4_apo.d.map filetype=ascii skip=6
